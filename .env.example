# Salin ke .env lalu isi. File .env TIDAK BOLEH di-commit.

# Database & cache (nilai default cocok dengan docker-compose.yml)
DATABASE_URL=postgresql://sportswear:sportswear@localhost:5433/sportswear?schema=public
REDIS_URL=redis://localhost:6379
# Database terpisah untuk test integrasi (order, stok, voucher). Kosong = test itu dilewati.
# Buat sekali: docker exec sportswear-postgres psql -U sportswear -d postgres -c "CREATE DATABASE sportswear_test;"
TEST_DATABASE_URL=postgresql://sportswear:sportswear@localhost:5433/sportswear_test?schema=public

# API
PORT=4000
RUN_JOBS=true               # job terjadwal (expire-order) ikut berjalan di proses API

# Auth — minimal 32 karakter. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL aplikasi
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# DOKU Checkout
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENV=sandbox            # sandbox | production
# Opsional: URL publik webhook, menggantikan Notification URL di back office per transaksi.
# Path WAJIB sama dengan di back office: /api/webhooks/doku. DOKU menolak domain ngrok;
# untuk development pakai localhost.run, mis. https://abc123.lhr.life/api/webhooks/doku
DOKU_NOTIFICATION_URL=https://1ae9e68a373f50.lhr.life/api/webhooks/doku

# RajaOngkir (Komerce). API key dari https://collaborator.komerce.id
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1

# Email (Resend / SMTP)
EMAIL_API_KEY=

# Object storage gambar produk
STORAGE_BUCKET=
STORAGE_DRIVER=local        # local (dev). S3/R2 menyusul.
UPLOADS_DIR=                # kosong = apps/api/uploads
