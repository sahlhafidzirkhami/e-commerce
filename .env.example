# Salin ke .env lalu isi. File .env TIDAK BOLEH di-commit.

# Database & cache (nilai default cocok dengan docker-compose.yml)
DATABASE_URL=postgresql://sportswear:sportswear@localhost:5433/sportswear?schema=public
REDIS_URL=redis://localhost:6379

# API
PORT=4000

# Auth — minimal 32 karakter. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL aplikasi
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# DOKU Checkout
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENV=sandbox            # sandbox | production

# RajaOngkir
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=

# Email (Resend / SMTP)
EMAIL_API_KEY=

# Object storage gambar produk
STORAGE_BUCKET=
