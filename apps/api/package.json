{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "import:shopee": "tsx --env-file=../../.env src/scripts/import-shopee.ts",
    "user:create-owner": "tsx --env-file=../../.env src/scripts/create-owner.ts",
    "region:sync": "tsx --env-file=../../.env src/scripts/sync-regions.ts",
    "shipping:configure": "tsx --env-file=../../.env src/scripts/configure-shipping.ts",
    "email:test": "tsx --env-file=../../.env src/scripts/send-test-email.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@sportswear/shared": "workspace:^",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
